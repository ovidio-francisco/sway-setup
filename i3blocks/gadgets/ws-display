#!/usr/bin/env python3

import i3ipc
import sys

i3 = i3ipc.Connection()
gost="<span color='black'> </span>"

a = [ "0",
      "▀"+gost, gost+"▀", 
      "▄"+gost, gost+"▄"]


wscolor="'#4c7899'"


def getWs():
    return i3.get_tree().find_focused().workspace().num


def printDisplay(i3, e):

    n = getWs()

    display = "<span color=%s>%s</span>" % (wscolor, n if n > 4 else a[n])

    print(display)
    sys.stdout.flush()



printDisplay(i3, None)

i3.on('workspace::focus', printDisplay)

i3.main()



